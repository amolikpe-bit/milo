{
  "name": "milo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "setup": "sh scripts/setup.sh",
    "dev": "sh scripts/with-bun.sh --hot scripts/dev.ts",
